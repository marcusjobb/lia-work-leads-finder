# ── LLM Provider ────────────────────────────────────────────────
# Välj en: claude-cli | openrouter | anthropic
# claude-cli försöker först, faller tillbaka till openrouter om det misslyckas.
LLM_PROVIDER=claude-cli

# ── OpenRouter (fallback / primär) ──────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=minimax/minimax-m2.7

# ── Anthropic SDK (direkt) ───────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Företagsdata API:er ─────────────────────────────────────────
# foretagsapi.se — gratis tier, sökning per bolagsnamn
# Registrera på foretagsapi.se för API-nyckel (valfri, guest-läge fungerar utan)
# FORETAGSAPI_KEY=fapi_...

# bolagsapi.se — gratis tier, lookup per orgnr, ger finansiell hälsopoäng
# Kräver nyckel: bolagsapi.se/register
# BOLAGSAPI_KEY=sk_live_...

# ── Exempelbrev (few-shot stilreferens) ─────────────────────────
# Valfri. Pekar på ett befintligt brev som LLM:en matchar tonen mot.
# EXAMPLE_LETTER_PATH=pers-brev-example.md
